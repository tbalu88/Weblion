+function cp_tabs_panel() { return array('naptar', 'kovetes', 'hatterek', 'munkalap', 'elszamolas', 'ellenorzes', 'tarca'); }
+function cp_tabs_data() { return array_merge(array('deals', 'kapcsolatok', 'mail', 'feladatok'), cp_tabs_panel()); }
+function cp_panel_can_any($tabs) {
+	foreach ((array) $tabs as $t) { if (cp_panel_can_x($t)) { return true; } }
+	return false;
+}
+function cp_tab_need($tabs) {
+	if (!cp_panel_can_any($tabs)) { wp_send_json_error(array('msg' => 'Ehhez a funkcióhoz a fiókodnak nincs jogosultsága.'), 403); }
+}
+function cp_admin_need() {
+	if (!cp_panel_is_admin()) { wp_send_json_error(array('msg' => 'Ezt csak admin fiók teheti meg.'), 403); }
