+function cp_panel_setcookie($val, $exp) {
+	$sec = is_ssl() || strpos((string) home_url(), 'https:') === 0;
+	if (PHP_VERSION_ID >= 70300) { setcookie(CP_PANEL_COOKIE, $val, array('expires' => $exp, 'path' => '/', 'secure' => $sec, 'httponly' => true, 'samesite' => 'Lax')); }
