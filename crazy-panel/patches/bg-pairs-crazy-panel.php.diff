+/* kétoldalas hátterek: kisbetűs név => a pár másik oldalának neve (mindkét irányban) */
+function cp_panel_bg_pairs() {
+	static $memo = null;
+	if ($memo !== null) { return $memo; }
+	$o = cp_panel_opts();
+	$memo = array();
+	foreach (cp_panel_lines(isset($o['bg_pairs']) ? $o['bg_pairs'] : '') as $l) {
+		$p = preg_split('/\s+[-–—]\s+/u', trim($l), 2);
+		if (count($p) !== 2) { continue; }
+		$a = trim($p[0]); $b = trim($p[1]);
+		if ($a === '' || $b === '' || cp_panel_lc($a) === cp_panel_lc($b)) { continue; }
+		$memo[cp_panel_lc($a)] = $b;
+		$memo[cp_panel_lc($b)] = $a;
+	}
+	return $memo;
+}
+function cp_panel_bg_partner($name) {
+	$m = cp_panel_bg_pairs();
+	$k = cp_panel_lc($name);
+	return isset($m[$k]) ? $m[$k] : '';
+}
+/* a párlistában szereplő, de a háttérlistában nem található nevek (a beállításoknál figyelmeztetés) */
+function cp_panel_bg_pairs_unknown() {
+	$known = array();
+	foreach (cp_panel_bg_list() as $b) { $known[cp_panel_lc($b['name'])] = 1; }
+	$out = array();
+	foreach (cp_panel_bg_pairs() as $k => $partner) { if (!isset($known[$k])) { $out[] = cp_panel_bg_partner($partner); } }
+	return array_values(array_unique($out));
+}
+
 function cp_panel_lc($s) {
 	return mb_strtolower(trim((string) $s));
 }
