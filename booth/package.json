{
  "name": "crazy-booth",
  "productName": "Crazy Booth",
  "version": "0.1.0",
  "description": "EventCrazy szelfigép-szoftver (Windows, Nikon D5300 + DNP DS620)",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "hu.eventcrazy.booth",
    "productName": "Crazy Booth",
    "files": ["src/**/*", "assets/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
