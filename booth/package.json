{
  "name": "crazy-booth",
  "productName": "Crazy Booth",
  "version": "0.10.0",
  "description": "EventCrazy szelfigép-szoftver (Mac: webkamera; Windows: Nikon D5300 vagy webkamera) + DNP DS620",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mock": "electron . --mock",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "hu.eventcrazy.booth",
    "productName": "Crazy Booth",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "extendInfo": {
        "NSCameraUsageDescription": "A Crazy Booth a kamerával készíti a fotókat.",
        "NSMicrophoneUsageDescription": "A Crazy Booth nem használ hangot; a kamera engedélyéhez kérheti a rendszer."
      }
    }
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "uiShellMin": "0.5.0"
}
